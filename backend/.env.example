# Database
DB_USERNAME=root
DB_PASSWORD=

# Mail (Gmail 앱 비밀번호 사용 - 일반 비밀번호 X)
# 발급: Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호에서 생성해주세요
MAIL_USERNAME=your_gmail@gmail.com
MAIL_APP_PASSWORD=your_gmail_app_password
# 로컬/시연: true면 메일 안 보내고 서버 콘솔에 인증 코드 출력
MAIL_DEV_MODE=true
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_jwt_secret_key

# Google OAuth
# 발급: Google Cloud Console → API 및 서비스 → 사용자 인증 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URL
FRONTEND_URL=http://localhost:5173
# S3 (운영 / 스테이징)
S3_ENABLED=false
S3_BUCKET=your-bucket-name
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# MinIO 등 S3 호환 스토리지 사용 시
S3_ENDPOINT=
# CloudFront 등 공개 URL (미설정 시 S3 기본 URL)
S3_PUBLIC_URL_BASE=
